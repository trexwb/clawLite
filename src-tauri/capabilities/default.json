{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Claw Lite 主窗口默认能力",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    { "identifier": "http:default", "allow": [
      { "url": "https://**" },
      { "url": "http://localhost:*" },
      { "url": "http://127.0.0.1:*" }
    ] }
  ]
}
