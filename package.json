{
  "name": "claw-lite",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Claw Lite — DeepSeek Harness 桌面宿主（Electron，内置 DSH 运行时，用户免装 Node）",
  "author": "trexwb",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build:web": "vite build",
    "start": "npm run build:web && electron .",
    "electron": "electron .",
    "runtime": "node scripts/fetch-runtime.mjs",
    "runtime:force": "node scripts/fetch-runtime.mjs --force",
    "check": "node scripts/check.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "dist": "npm run build:web && electron-builder",
    "dist:mac": "npm run build:web && electron-builder --mac",
    "dist:win": "npm run build:web && electron-builder --win",
    "dist:linux": "npm run build:web && electron-builder --linux"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "vite": "^6.0.0"
  }
}
